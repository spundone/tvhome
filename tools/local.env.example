# Copy to tools/local.env and edit. tools/local.env is git-ignored.
# ADB serial of the TV (ip:port from Wireless debugging, or the adb-...tls-connect name)
TV_SERIAL=192.168.x.x:5555
# Default name for the first profile (rename any time from the Profile pill on the TV)
TVHOME_GREETING_NAME=Guest
TVHOME_WIFI_NAME=
TVHOME_HOTSPOT_SSID=TvHome-Hotspot
TVHOME_HOTSPOT_PASS=change-me-please
# Leave blank to locate by IP once; or pin a place:
TVHOME_WEATHER_LAT=
TVHOME_WEATHER_LON=
TVHOME_WEATHER_CITY=
