    <app package_name="com.tcl.partnercustomizer.resource" quota="2"/> 
  </partner-app-channel-quota>  
  <partner-favorite-apps-out-of-box-order> 
    <app name="netflix" package_name="com.netflix.ninja"/>  
    <app name="HULU" package_name="jp.happyon.android"/>
    <app name="TCL Channel" package_name="com.tcl.partnercustomizer"/>
    <app name="mediaCenter" package_name="com.tcl.ui_mediaCenter"/>  
    <app name="youtube" package_name="com.google.android.youtube.tv"/>  
    <app name="Google Play Movies" package_name="com.google.android.videos"/>  
    <app name="TV Guard" package_name="com.tcl.tvweishi"/>
    <app name="Youtube games" package_name="com.google.android.play.games"/>
	<app name="tv" package_name="com.tcl.tv"/>    
  </partner-favorite-apps-out-of-box-order> 
  <partner-all-apps-out-of-box-order>
	<app name="netflix" package_name="com.netflix.ninja" />
	<app name="TCL Channel" package_name="com.tcl.partnercustomizer" />
	<app name="mediaCenter" package_name="com.tcl.ui_mediaCenter"/>  
	<app name="TV Guard" package_name="com.tcl.tvweishi" />
	<app name="youtube" package_name="com.google.android.youtube.tv" />
	<app name="Google Play Movies" package_name="com.google.android.videos" />
	<app name="music" package_name="com.google.android.music" />
	<app name="store" package_name="com.android.vending" />
	<app name="Youtube games" package_name="com.google.android.play.games"/>
  </partner-all-apps-out-of-box-order>
  <partner-package-notification-whitelist>
    <package-name>com.tcl.messagebox</package-name>
    <package-name>com.tcl.partnercustomizer</package-name>
    <package-name>com.tcl.notereminder</package-name>
    <package-name>com.tcl.ttvs</package-name>
    <package-name>com.tcl.useragreement</package-name>
  </partner-package-notification-whitelist>
