<?xml version="1.0" encoding="utf-8"?>

<configuration> 
  <inputs-configuration show_inputs="true" show_physical_tuners_separately="true"/>  
  <partner-channels-out-of-box-order> 
    <package-name>com.netflix.ninja</package-name>  
    <package-name>com.tcl.partnercustomizer</package-name>
    <package-name>com.tcl.partnercustomizer.resource</package-name>
    <package-name>com.tcl.partnercustomizer.resource</package-name>     
    <package-name>com.google.android.youtube.tv</package-name>  
